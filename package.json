{
  "name": "album-grid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node --env-file=.env --watch server/server.ts",
    "dev:web": "vite",
    "dev": "npm run dev:server & npm run dev:web",
    "build": "vite build",
    "start": "node --env-file=.env server/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
